# ---> dataverse-swa-dashboard — env template <---
# Copy to .env or set in SWA / Functions App Settings.
# Never commit real values. All DATAVERSE_* secrets are server-only.

# ── Dataverse connection (server-only; never expose to browser) ──
DATAVERSE_URL=https://your-org.crm.dynamics.com
DATAVERSE_TENANT_ID=00000000-0000-0000-0000-000000000000
DATAVERSE_CLIENT_ID=00000000-0000-0000-0000-000000000000
DATAVERSE_CLIENT_SECRET=replace-with-client-secret-or-use-cert

# ── Mode ──
# mock = deterministic fixtures (default for local dev, no credentials needed)
# live = real Dataverse Web API via MSAL confidential client
DATAVERSE_MODE=mock

# ── Entra / auth ──
# Comma-separated list of allowed Entra tenant IDs (empty = accept any when SWA auth disabled; enforce in production)
ENTRA_ALLOWED_TENANT_IDS=

# ── API ──
API_CACHE_TTL=60

# ── Frontend (Vite) ──
# Same-origin by default; only override for local proxy debugging.
VITE_API_BASE=/api

# ── Observability (optional) ──
# Set by infra/main.bicep when App Insights is provisioned.
APPLICATIONINSIGHTS_CONNECTION_STRING=
APPINSIGHTS_INSTRUMENTATIONKEY=
